<Window x:Class="CodexDuo.Windows.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Duo" Width="390" Height="480" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Border BorderBrush="#405B7CFA" BorderThickness="1" CornerRadius="14" Padding="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="5,3,5,10"><TextBlock Text="Codex Duo" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Select an account to switch and restart Codex" Opacity=".62" FontSize="11"/></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AccountsPanel"/></ScrollViewer>
      <DockPanel Grid.Row="2" Margin="2,10,2,0">
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity=".65" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Settings" Click="Settings_Click"/><Button Content="Quit" Click="Quit_Click"/></StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
