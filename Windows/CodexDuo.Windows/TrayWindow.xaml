<Window x:Class="CodexDuo.Windows.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexDuo.Windows"
        Title="Codex Duo" Width="356" MaxHeight="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:StringToVisibilityConverter x:Key="StringVisibility" />
    <Style x:Key="UsageLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="8.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
    </Style>
    <Style x:Key="BadgeStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0.5" />
    </Style>
    <Style x:Key="AccountRowStyle" TargetType="Button">
      <Setter Property="Height" Value="60" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RowChrome" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5">
              <Grid>
                <Border x:Name="Refraction" CornerRadius="8" Opacity="0">
                  <Border.Background>
                    <RadialGradientBrush Center="0.28,0.18" GradientOrigin="0.28,0.18" RadiusX="0.85" RadiusY="1.2">
                      <GradientStop Color="#38FFFFFF" Offset="0" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                  </Border.Background>
                </Border>
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter TargetName="Refraction" Property="Opacity" Value="0.55" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                <Setter TargetName="Refraction" Property="Opacity" Value="0.7" />
              </Trigger>
              <DataTrigger Binding="{Binding CanSwitch}" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter TargetName="Refraction" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RowChrome" Property="Background" Value="Transparent" />
                <Setter TargetName="RowChrome" Property="BorderBrush" Value="Transparent" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="PreviewMouseDown"><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.07" />
          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.07" />
        </Storyboard></BeginStoryboard></EventTrigger>
        <EventTrigger RoutedEvent="PreviewMouseUp"><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
        </Storyboard></BeginStoryboard></EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
        </Storyboard></BeginStoryboard></EventTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="25" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style x:Key="MeterStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="3" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource MeterBrush}" />
      <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid Height="3" ClipToBounds="True">
              <Border CornerRadius="1.5" Background="{TemplateBinding Background}" />
              <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                <Border CornerRadius="1.5" Background="{TemplateBinding Foreground}" />
              </Decorator>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="10" CornerRadius="10" Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" ToolTip="{Binding Warning}">
    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="34" /></Grid.RowDefinitions>
      <Border Margin="12,8,12,2" Padding="9,6" CornerRadius="6" Background="{DynamicResource HoverBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5"
              Visibility="{Binding Error, Converter={StaticResource StringVisibility}}">
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" />
      </Border>
      <Border Grid.Row="1" Margin="12,4,12,2" Padding="9,6" CornerRadius="6" Background="{DynamicResource HoverBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5"
              Visibility="{Binding Warning, Converter={StaticResource StringVisibility}}">
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" />
      </Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="568" Padding="8,4" Background="Transparent">
        <Grid>
          <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="16,18" HorizontalAlignment="Center"
                     TextAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                     Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVisibility}}" />
          <ItemsControl ItemsSource="{Binding Accounts}" Visibility="{Binding HasAccounts, Converter={StaticResource BoolVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Button Style="{StaticResource AccountRowStyle}" Click="Account_Click">
                    <Grid Margin="8,0,9,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="7" /><ColumnDefinition Width="9" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Border Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource SecondaryTextBrush}"
                              Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" />
                      <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="23" /></Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                          <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" DockPanel.Dock="Right" Margin="6,0,0,0" FontSize="9"
                                     Foreground="{DynamicResource QuaternaryTextBrush}" VerticalAlignment="Center"
                                     Visibility="{Binding CanSwitch, Converter={StaticResource BoolVisibility}}" />
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Style="{StaticResource BadgeStyle}" Margin="0,0,6,0">
                              <TextBlock Text="{Binding PlanText}" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" />
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}" Margin="0,0,6,0"
                                    Visibility="{Binding AgeText, Converter={StaticResource StringVisibility}}">
                              <TextBlock Text="{Binding AgeText}" FontSize="8.5" Foreground="{DynamicResource TertiaryTextBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding DisplayName}" FontSize="11.5"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontWeight" Value="Medium" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DockPanel>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding UsageMeters}" Tag="{Binding UsageColumnCount}" Margin="-6,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="1" Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="6,0">
                                <DockPanel LastChildFill="False">
                                  <TextBlock Text="{Binding Label}" Style="{StaticResource UsageLabel}" />
                                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PercentageText}" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text=" · " FontSize="9" Foreground="{DynamicResource QuaternaryTextBrush}"
                                               Visibility="{Binding HasReset, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding Reset}" FontFamily="Segoe UI Variable Small, Segoe UI" FontSize="9" FontWeight="SemiBold"
                                               Visibility="{Binding HasReset, Converter={StaticResource BoolVisibility}}" />
                                  </StackPanel>
                                </DockPanel>
                                <ProgressBar Value="{Binding Remaining, Mode=OneWay}" Margin="0,5,0,0">
                                  <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource MeterStyle}">
                                      <Style.Triggers><DataTrigger Binding="{Binding IsLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource LowMeterBrush}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                  </ProgressBar.Style>
                                </ProgressBar>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Grid>
                  </Button>
                  <Border Height="0.5" VerticalAlignment="Bottom" Margin="16,0" Background="{DynamicResource BorderBrush}"
                          Visibility="{Binding ShowsSeparator, Converter={StaticResource BoolVisibility}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="14,0">
        <Border Height="0.5" VerticalAlignment="Top" Margin="10,0" Background="{DynamicResource BorderBrush}" />
        <DockPanel VerticalAlignment="Center" LastChildFill="False">
          <Button Style="{StaticResource FooterButtonStyle}" Click="Settings_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="{Binding SettingsText}" /></StackPanel>
          </Button>
          <Button Style="{StaticResource FooterButtonStyle}" DockPanel.Dock="Right" Click="Quit_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="{Binding QuitText}" /></StackPanel>
          </Button>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
