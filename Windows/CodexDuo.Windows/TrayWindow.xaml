<Window x:Class="CodexDuo.Windows.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexDuo.Windows"
        Title="Codex Duo" Width="420" MaxHeight="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
  <Window.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="UsageLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
  </Window.Resources>
  <Border Margin="10" Padding="16" CornerRadius="18" Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="2,0,2,12">
        <Image Source="Resources/CodexDuo.png" Width="32" Height="32" Stretch="UniformToFill" Margin="0,0,10,0" />
        <StackPanel>
          <TextBlock Text="Codex Duo" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding AccountsTitle}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1" Background="#18F59E0B" BorderBrush="#55F59E0B" BorderThickness="1" CornerRadius="8"
              Padding="9" Margin="0,0,0,10" Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="#FFD97706" FontSize="12" />
      </Border>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <Grid>
          <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="8,18" HorizontalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVisibility}}" />
          <ItemsControl ItemsSource="{Binding Accounts}" Visibility="{Binding HasAccounts, Converter={StaticResource BoolVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding SwitchCommand}" Padding="0" Margin="0,0,0,8" BorderThickness="0" HorizontalContentAlignment="Stretch">
                  <Border Padding="13" CornerRadius="12" Background="{DynamicResource CardBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                          <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding AgeText}" FontSize="9" Margin="0,0,8,0" Foreground="#FFF59E0B" />
                          <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7,2"
                                  Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding ActiveText}" FontSize="9" Foreground="White" FontWeight="SemiBold" />
                          </Border>
                        </StackPanel>
                      </Grid>
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Visibility="{Binding HasFiveHour, Converter={StaticResource BoolVisibility}}">
                          <DockPanel><TextBlock Text="{Binding FiveHourLabel}" Style="{StaticResource UsageLabel}" /><TextBlock Text="{Binding FiveHourReset}" DockPanel.Dock="Right" Style="{StaticResource UsageLabel}" /></DockPanel>
                          <ProgressBar Value="{Binding FiveHourRemaining}" Maximum="100" Height="5" Margin="0,6,0,3" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="{Binding FiveHourRemaining}" /><Run Text="% " /><Run Text="{Binding RemainingLabel}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding HasWeekly, Converter={StaticResource BoolVisibility}}">
                          <DockPanel><TextBlock Text="{Binding WeeklyLabel}" Style="{StaticResource UsageLabel}" /><TextBlock Text="{Binding WeeklyReset}" DockPanel.Dock="Right" Style="{StaticResource UsageLabel}" /></DockPanel>
                          <ProgressBar Value="{Binding WeeklyRemaining}" Maximum="100" Height="5" Margin="0,6,0,3" Foreground="#FF19B6C9" Background="{DynamicResource BorderBrush}" BorderThickness="0" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="{Binding WeeklyRemaining}" /><Run Text="% " /><Run Text="{Binding RemainingLabel}" /></TextBlock>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Button Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" />
        <Button Grid.Column="2" Content="{Binding SettingsText}" Click="Settings_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
