<Window x:Class="CodexDuo.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Duo Settings" Width="640" Height="620" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="Resources/CodexDuo.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Codex Duo" FontSize="24" FontWeight="SemiBold" />
      <TextBlock x:Name="SettingsHeading" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,18" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="AppearanceLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="AppearanceBox" Grid.Column="1" SelectedValuePath="Key" DisplayMemberPath="Value" />
        </Grid>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedValuePath="Key" DisplayMemberPath="Value" />
        </Grid>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="IntervalLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="IntervalBox" Grid.Column="1" SelectedValuePath="Key" DisplayMemberPath="Value" />
        </Grid>
        <CheckBox x:Name="StartupCheck" Margin="0,0,0,12" />
        <CheckBox x:Name="ActivationCheck" Margin="0,0,0,20" />

        <Separator Margin="0,0,0,16" />
        <TextBlock x:Name="AccountsLabel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox x:Name="AccountList" MinHeight="160" DisplayMemberPath="DisplayName" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="AddButton" Click="Add_Click" Margin="0,0,8,0" />
          <Button x:Name="RenameButton" Click="Rename_Click" Margin="0,0,8,0" />
          <Button x:Name="RemoveButton" Click="Remove_Click" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock Text="Changes apply immediately after Apply." Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
      <Button x:Name="ApplyButton" DockPanel.Dock="Right" Width="110" Click="Apply_Click" Background="{DynamicResource AccentBrush}" Foreground="White" />
    </DockPanel>
  </Grid>
</Window>
