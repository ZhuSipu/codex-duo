<Window x:Class="CodexDuo.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexDuo.Windows"
        Title="Codex Duo Settings" Width="600" Height="600" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Resources/CodexDuo.ico"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="13,9" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentChrome" Padding="9,4" CornerRadius="5" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentChrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentChrome" Property="Background" Value="{DynamicResource ElevatedBrush}" /><Setter TargetName="SegmentChrome" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemChrome" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PressedBrush}" /><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
      <StackPanel Margin="24,18,24,15">
        <TextBlock Text="Codex Duo" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15" />

        <TextBlock x:Name="GeneralHeading" Style="{StaticResource SectionHeading}" Margin="1,0,0,6" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Height="34">
              <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="LanguageLabel" Style="{StaticResource FormLabel}" />
              <ComboBox x:Name="LanguageBox" Grid.Column="2" SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="Choice_Changed" />
            </Grid>
            <Separator Background="{DynamicResource BorderBrush}" />
            <Grid Height="34">
              <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="AppearanceLabel" Style="{StaticResource FormLabel}" />
              <Border Grid.Column="2" CornerRadius="7" Padding="2" Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="SystemAppearance" GroupName="Appearance" Content="System" Tag="system" Style="{StaticResource Segment}" Click="Appearance_Click" />
                  <RadioButton x:Name="LightAppearance" GroupName="Appearance" Content="Light" Tag="light" Style="{StaticResource Segment}" Click="Appearance_Click" />
                  <RadioButton x:Name="DarkAppearance" GroupName="Appearance" Content="Dark" Tag="dark" Style="{StaticResource Segment}" Click="Appearance_Click" />
                </UniformGrid>
              </Border>
            </Grid>
            <Separator Background="{DynamicResource BorderBrush}" />
            <Grid Height="34">
              <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="IntervalLabel" Style="{StaticResource FormLabel}" />
              <ComboBox x:Name="IntervalBox" Grid.Column="2" SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="Choice_Changed" />
            </Grid>
            <Separator Background="{DynamicResource BorderBrush}" />
            <Grid Height="34"><CheckBox x:Name="StartupCheck" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Check_Changed" /></Grid>
            <Separator Background="{DynamicResource BorderBrush}" />
            <Grid Height="34"><CheckBox x:Name="ActivationCheck" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Check_Changed" /></Grid>
          </StackPanel>
        </Border>

        <TextBlock x:Name="AccountsHeading" Style="{StaticResource SectionHeading}" Margin="1,13,0,6" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Height="22">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding AccountCountText}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding DependencyText}" FontSize="10.5"
                         Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </Grid>
            <Separator Background="{DynamicResource BorderBrush}" Margin="0,3,0,2" />
            <ListBox x:Name="AccountList" Height="96" ItemsSource="{Binding Accounts}" BorderThickness="0"
                     Background="Transparent" SelectionChanged="AccountList_SelectionChanged"
                     ItemContainerStyle="{StaticResource AccountItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="23" /><ColumnDefinition Width="9" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                          <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="FontWeight" Value="Medium" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding SecondaryText}" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding ActiveText}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,0" />
            <DockPanel Margin="0,7,0,0" LastChildFill="False">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Click="Add_Click" Margin="0,0,6,0" />
                <Button x:Name="RenameButton" Click="Rename_Click" Margin="0,0,6,0" />
                <Button x:Name="RemoveButton" Click="Remove_Click" Margin="0,0,6,0" />
                <Button x:Name="InstallButton" Click="Install_Click" />
              </StackPanel>
              <Button x:Name="RefreshButton" DockPanel.Dock="Right" Click="Refresh_Click" />
            </DockPanel>
            <TextBlock x:Name="StatusLabel" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" Margin="1,6,0,0" MinHeight="14" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
