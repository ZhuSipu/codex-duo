<Window x:Class="CodexDuo.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Duo Settings" Width="580" Height="620" MinWidth="540" MinHeight="560"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Codex Duo" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Account switching and usage preferences" Opacity=".62"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,22,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <TextBlock Text="Appearance" VerticalAlignment="Center"/><ComboBox x:Name="AppearanceBox" Grid.Column="1" SelectionChanged="AppearanceBox_Changed"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
      <TextBlock Grid.Row="1" Text="Automatic refresh" VerticalAlignment="Center"/><ComboBox x:Name="RefreshBox" Grid.Row="1" Grid.Column="1" SelectionChanged="RefreshBox_Changed"><ComboBoxItem Content="Off" Tag="0"/><ComboBoxItem Content="Every minute" Tag="60"/><ComboBoxItem Content="Every 2 minutes" Tag="120"/><ComboBoxItem Content="Every 5 minutes" Tag="300"/><ComboBoxItem Content="Every 10 minutes" Tag="600"/><ComboBoxItem Content="Every 15 minutes" Tag="900"/></ComboBox>
      <TextBlock Grid.Row="2" Text="Startup" VerticalAlignment="Center"/><CheckBox x:Name="StartupCheck" Grid.Row="2" Grid.Column="1" Content="Open Codex Duo when I sign in" VerticalAlignment="Center" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
    </Grid>
    <GroupBox Grid.Row="2" Header="Accounts" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="DependencyText" TextWrapping="Wrap" Opacity=".7" Margin="4"/>
      <ListBox x:Name="AccountsList" Grid.Row="1" DisplayMemberPath="DisplayName" Margin="0,8"/>
      <WrapPanel Grid.Row="2"><Button Content="Add Account…" Click="Add_Click"/><Button Content="Rename…" Click="Rename_Click"/><Button Content="Remove…" Click="Remove_Click"/><Button Content="Refresh Now" Click="Refresh_Click"/><Button x:Name="InstallButton" Content="Install codex-auth…" Click="Install_Click"/></WrapPanel>
    </Grid></GroupBox>
    <TextBlock Grid.Row="3" Margin="0,14,0,0" FontSize="11" Opacity=".58" TextWrapping="Wrap" Text="Credentials remain managed by codex-auth. Codex Duo never displays or stores access tokens. Adding an account opens the official Codex login flow in Command Prompt."/>
  </Grid>
</Window>
