<Window x:Class="CodexDuo.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexDuo.Windows"
        Title="Codex Duo Settings" Width="560" Height="600" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="Resources/CodexDuo.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:StringToVisibilityConverter x:Key="StringVisibility" />

    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="FluentIcon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentChrome" Padding="7,4" CornerRadius="5" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SegmentChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SegmentChrome" Property="Background" Value="{DynamicResource ElevatedBrush}" />
                <Setter TargetName="SegmentChrome" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="DestructiveActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="#FFD85A5A" />
    </Style>
    <Style x:Key="AccountItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowChrome" CornerRadius="8" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrayExpander" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="HeaderToggle"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            HorizontalContentAlignment="Stretch">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleChrome" Padding="18,11" CornerRadius="8" Background="Transparent">
                      <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource TrackBrush}">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource FluentIcon}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Header}" FontSize="10.5" FontWeight="SemiBold" />
                    <TextBlock Text="{TemplateBinding Tag}" Margin="0,2,0,0" FontSize="9.5"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock x:Name="Chevron" Grid.Column="2" Text="&#xE70D;" Style="{StaticResource FluentIcon}"
                             FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}" />
                </Grid>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite" Margin="55,0,18,14" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20,16,20,20">
      <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Image Source="Resources/CodexDuo.png" Width="24" Height="24" Margin="0,0,9,0" />
        <TextBlock x:Name="PageTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <Border x:Name="SettingsSurface" Grid.Row="2" Style="{StaticResource Surface}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
          <StackPanel>
            <Grid Height="44" Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" FontSize="13"
                         Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" />
              <TextBlock x:Name="GeneralHeading" Grid.Column="1" Style="{StaticResource SectionHeading}" Margin="7,0,0,0" />
            </Grid>
            <Border Height="1" Margin="18,0" Background="{DynamicResource BorderBrush}" />

            <Grid Height="42" Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="LanguageLabel" Style="{StaticResource FormLabel}" />
              <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="230" HorizontalAlignment="Right"
                        SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="Choice_Changed" />
            </Grid>
            <Border Height="1" Margin="18,0" Background="{DynamicResource BorderBrush}" />
            <Grid Height="42" Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="AppearanceLabel" Style="{StaticResource FormLabel}" />
              <Border x:Name="AppearanceControl" Grid.Column="1" Width="230" Height="30" HorizontalAlignment="Right"
                      VerticalAlignment="Center" CornerRadius="7" Padding="2"
                      Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="SystemAppearance" GroupName="Appearance" Content="System" Tag="system" Style="{StaticResource Segment}" Click="Appearance_Click" />
                  <RadioButton x:Name="LightAppearance" GroupName="Appearance" Content="Light" Tag="light" Style="{StaticResource Segment}" Click="Appearance_Click" />
                  <RadioButton x:Name="DarkAppearance" GroupName="Appearance" Content="Dark" Tag="dark" Style="{StaticResource Segment}" Click="Appearance_Click" />
                </UniformGrid>
              </Border>
            </Grid>
            <Border Height="1" Margin="18,0" Background="{DynamicResource BorderBrush}" />
            <Grid Height="42" Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="IntervalLabel" Style="{StaticResource FormLabel}" />
              <ComboBox x:Name="IntervalBox" Grid.Column="1" Width="230" HorizontalAlignment="Right"
                        SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="Choice_Changed" />
            </Grid>
            <Border Height="1" Margin="18,0" Background="{DynamicResource BorderBrush}" />
            <Grid Height="42" Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <CheckBox x:Name="StartupCheck" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Check_Changed">
                <TextBlock x:Name="StartupText" MaxWidth="230" TextAlignment="Right" TextWrapping="Wrap" />
              </CheckBox>
            </Grid>

            <Border Height="1" Margin="18,2,18,0" Background="{DynamicResource StrongBorderBrush}" />
            <Grid Height="50" Margin="18,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AccountsHeading" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="{Binding DependencyText}" Margin="0,2,0,0" FontSize="9.5"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="1" Padding="7,2" CornerRadius="6" Background="{DynamicResource TrackBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountCountText}" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" />
              </Border>
            </Grid>

            <Border x:Name="InstallBanner" Margin="18,0,18,8" Padding="8" CornerRadius="8"
                    Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding Visibility, ElementName=InstallButton}">
              <Button x:Name="InstallButton" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left" Click="Install_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" Style="{StaticResource FluentIcon}" Margin="0,0,7,0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock x:Name="InstallButtonText" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Border>

            <Grid MinHeight="74" MaxHeight="112" Margin="10,0">
              <ListBox x:Name="AccountList" ItemsSource="{Binding Accounts}" MaxHeight="112" BorderThickness="0" Background="Transparent"
                       SelectionChanged="AccountList_SelectionChanged" ItemContainerStyle="{StaticResource AccountItemStyle}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="8,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource TrackBrush}">
                        <Grid>
                          <TextBlock Text="&#xE77B;" Style="{StaticResource FluentIcon}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" />
                          <Border Width="7" Height="7" Margin="0,0,-2,-2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  CornerRadius="3.5" Background="{DynamicResource AccentBrush}"
                                  Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="FontWeight" Value="Medium" />
                              <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SecondaryText}" Margin="0,3,0,0" FontSize="9.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" Padding="7,2" CornerRadius="6" Background="{DynamicResource TrackBrush}"
                              VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding ActiveText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding EmptyText}" MaxWidth="280" FontSize="10" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
            </Grid>

            <Border Margin="18,6,18,0" Padding="9,6" CornerRadius="7" Background="{DynamicResource TrackBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding Text, ElementName=StatusLabel, Converter={StaticResource StringVisibility}}">
              <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource FluentIcon}" Margin="0,0,7,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="StatusLabel" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <Grid Height="48">
              <Border Height="1" VerticalAlignment="Top" Margin="18,0" Background="{DynamicResource BorderBrush}" />
              <DockPanel Margin="18,0" VerticalAlignment="Center" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <Button x:Name="AddButton" Style="{StaticResource ActionButton}" Margin="0,0,7,0" Click="Add_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Margin="0,0,6,0" /><TextBlock x:Name="AddButtonText" FontSize="10.5" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button x:Name="RenameButton" Style="{StaticResource ActionButton}" Margin="0,0,7,0" Click="Rename_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource FluentIcon}" Margin="0,0,6,0" /><TextBlock x:Name="RenameButtonText" FontSize="10.5" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button x:Name="RemoveButton" Style="{StaticResource DestructiveActionButton}" Click="Remove_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" Margin="0,0,6,0" /><TextBlock x:Name="RemoveButtonText" FontSize="10.5" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                </StackPanel>
                <Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Click="Refresh_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Margin="0,0,6,0" /><TextBlock x:Name="RefreshButtonText" FontSize="10.5" VerticalAlignment="Center" /></StackPanel>
                </Button>
              </DockPanel>
            </Grid>

            <Border Height="1" Margin="18,0" Background="{DynamicResource BorderBrush}" />
            <Expander x:Name="TrayGuideExpander" Style="{StaticResource TrayExpander}" IsExpanded="False">
              <StackPanel>
                <TextBlock x:Name="TrayGuideBody" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="15" />
                <TextBlock x:Name="TrayGuideSteps" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="15" />
                <Button x:Name="OpenTaskbarSettingsButton" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenTaskbarSettings_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" Margin="0,0,6,0" /><TextBlock x:Name="OpenTaskbarSettingsText" FontSize="10.5" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <TextBlock x:Name="TrayGuideStatus" Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringVisibility}}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</Window>
