<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexDuo</AssemblyName>
    <RootNamespace>CodexDuo.Windows</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\CodexDuo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>CodexDuo.Windows.App</StartupObject>
    <SyncInstalledCodexDuo Condition="'$(SyncInstalledCodexDuo)' == ''">true</SyncInstalledCodexDuo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexDuo.Windows.Core\CodexDuo.Windows.Core.csproj" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\CodexDuo.ico" />
    <Resource Include="Resources\CodexDuo.Tray.ico" />
    <Resource Include="Resources\CodexDuo.Tray.Light.ico" />
    <Resource Include="Resources\CodexDuo.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(IntermediateOutputPath)Helpers\codex-auth.exe" Link="Helpers\codex-auth.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="$(IntermediateOutputPath)Helpers\manifest.json" Link="Helpers\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="$(IntermediateOutputPath)Helpers\LICENSE" Link="Helpers\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="PrepareBundledCodexAuth" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'" Text="The bundled helper supports win-x64 only." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Scripts\prepare_windows_codex_auth.ps1&quot; -Destination &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Helpers&quot;" />
  </Target>
  <Target Name="SyncInstalledCodexDuoAfterBuild" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'
            and '$(DesignTimeBuild)' != 'true'
            and '$(CI)' != 'true'
            and '$(RuntimeIdentifier)' == ''
            and '$(SyncInstalledCodexDuo)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Scripts\sync_windows_build.ps1&quot; -BuildExecutable &quot;$(TargetDir)CodexDuo.exe&quot;" />
  </Target>
</Project>
