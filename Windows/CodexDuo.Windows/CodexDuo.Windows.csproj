<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexDuo</AssemblyName>
    <RootNamespace>CodexDuo.Windows</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\CodexDuo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>CodexDuo.Windows.App</StartupObject>
    <SyncInstalledCodexDuo Condition="'$(SyncInstalledCodexDuo)' == ''">true</SyncInstalledCodexDuo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexDuo.Windows.Core\CodexDuo.Windows.Core.csproj" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\CodexDuo.ico" />
    <Resource Include="Resources\CodexDuo.Tray.ico" />
    <Resource Include="Resources\CodexDuo.png" />
  </ItemGroup>
  <Target Name="SyncInstalledCodexDuoAfterBuild" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'
            and '$(DesignTimeBuild)' != 'true'
            and '$(CI)' != 'true'
            and '$(RuntimeIdentifier)' == ''
            and '$(SyncInstalledCodexDuo)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Scripts\sync_windows_build.ps1&quot; -BuildExecutable &quot;$(TargetDir)CodexDuo.exe&quot;" />
  </Target>
</Project>
