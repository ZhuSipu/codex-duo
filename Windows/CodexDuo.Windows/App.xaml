<Application x:Class="CodexDuo.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F8FC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF111827" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF667085" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1A101828" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF367AF6" />
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" /></Style>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
  </Application.Resources>
</Application>
