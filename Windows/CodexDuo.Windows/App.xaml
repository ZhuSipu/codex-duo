<Application x:Class="CodexDuo.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B7CFA"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="AccountButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#185B7CFA"/><Setter Property="BorderBrush" Value="#805B7CFA"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#305B7CFA"/></Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
